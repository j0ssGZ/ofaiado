# Append this isolated fragment to the existing gateway Caddyfile after backup.
# The existing gateway_caddy_config volume is already mounted at /config.
ofaiado.es {
    root * /config/ofaiado/current
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    @private path /.git /.git/* /.env /.env.* /node_modules /node_modules/* /package.json /package-lock.json /nuxt.config.* /Caddyfile
    respond @private 404

    @immutable path_regexp immutable ^/_nuxt/[^/]+\.(css|js)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @html path / /index.html
    header @html Cache-Control no-cache

    file_server
}

www.ofaiado.es {
    redir https://ofaiado.es{uri} 308
}
